# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-static/
/out/

# production / paquetes de subida (se regeneran)
/build
/export-build/
/Temp/

# preview local
.preview-*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Analítica (Hostinger). config.php se crea a mano y no se versiona.
config.php
analytics/private/config.php
analytics/private/logs/*
!analytics/private/logs/.gitkeep
analytics/private/rate/
